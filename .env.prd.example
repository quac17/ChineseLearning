# ============================================================================
# Mẫu biến môi trường tổng hợp cho môi trường PRODUCTION (Chinese Learner)
# Chạy `yarn env_prd` ở thư mục gốc để tự động tạo file `.env.prd` từ mẫu này
# ============================================================================

# ===== 1. PostgreSQL (GCP Cloud SQL) =====
POSTGRES_USER=chinese_learner
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PRD_PASSWORD
POSTGRES_DB=chinese_learner_db
# Chuỗi kết nối Cloud SQL qua Unix Socket trên Cloud Run:
DATABASE_URL=postgresql://chinese_learner:CHANGE_THIS_STRONG_PRD_PASSWORD@localhost/chinese_learner_db?host=/cloudsql/YOUR_PROJECT_ID:asia-southeast1:chinese-learner-pg

# ===== 2. Backend (NestJS — Cloud Run: chinese-learner-server) =====
NODE_ENV=production
PORT=4000

# Xác thực JWT & HTTP-only Cookie (Bắt buộc bật Secure trên HTTPS Production)
JWT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
COOKIE_NAME=chinese_learner_token
COOKIE_SECURE=true
# Dùng 'lax' khi FE & BE dùng chung tên miền cha (vd: chineselearner.vn & api.chineselearner.vn)
# Dùng 'none' nếu FE & BE chạy trên 2 tên miền khác nhau (vd: *.run.app)
COOKIE_SAME_SITE=lax

# CORS & Kho lưu trữ Media (mount GCS Bucket vào /app/uploads)
CORS_ORIGIN=https://chineselearner.vn,https://www.chineselearner.vn
UPLOAD_DIR=/app/uploads
MAX_VIDEO_SIZE_MB=500
MAX_DOC_SIZE_MB=50

# ===== 3. Frontend (Next.js — Cloud Run: chinese-learner-client) =====
# Truyền vào --build-arg NEXT_PUBLIC_API_URL khi build Docker image Frontend
NEXT_PUBLIC_API_URL=https://api.chineselearner.vn/api
