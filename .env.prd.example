# ============================================================================
# Mẫu biến môi trường tổng hợp cho môi trường PRODUCTION (tiengtrung365vn.com)
# Chạy `yarn env_prd` ở thư mục gốc để tự động tạo file `.env.prd` từ mẫu này.
# TUYỆT ĐỐI không commit `.env.prd` hoặc điền key thật vào file `.env.prd.example` này!
# ============================================================================

# ===== 0. Thông tin GCP Project =====
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCP_REGION=asia-southeast1
GCP_ARTIFACT_REPO=chinese-learner-repo
CLOUD_SQL_CONNECTION=YOUR_PROJECT_ID:asia-southeast1:chinese-learner-pg

# ===== 1. PostgreSQL (GCP Cloud SQL) =====
POSTGRES_USER=chinese_learner
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PRD_PASSWORD
POSTGRES_DB=chinese_learner_db
# Chuỗi kết nối Cloud SQL qua Unix Socket trên Cloud Run:
DATABASE_URL=postgresql://chinese_learner:CHANGE_THIS_STRONG_PRD_PASSWORD@localhost/chinese_learner_db?host=/cloudsql/YOUR_PROJECT_ID:asia-southeast1:chinese-learner-pg

# ===== 2. Backend (NestJS — Cloud Run: chinese-learner-server) =====
NODE_ENV=production
TRUST_PROXY=1

# Xác thực JWT & HTTP-only Cookie
JWT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
COOKIE_NAME=chinese_learner_token
COOKIE_SECURE=true
# Chung tên miền cha (tiengtrung365vn.com & api.tiengtrung365vn.com) -> dùng 'lax'
COOKIE_SAME_SITE=lax

# Tên miền & CORS
CORS_ORIGIN=https://tiengtrung365vn.com,https://www.tiengtrung365vn.com
APP_URL=https://tiengtrung365vn.com
API_PUBLIC_URL=https://api.tiengtrung365vn.com/api

# Kho lưu trữ Media (Google Cloud Storage Private Bucket)
STORAGE_BACKEND=gcs
GCS_BUCKET=YOUR_PROJECT_ID-chinese-learner-media
GCS_SIGNED_URL_TTL_MIN=15
GCS_UPLOAD_URL_TTL_MIN=30
UPLOAD_DIR=/tmp/chinese-learner-uploads
MAX_VIDEO_SIZE_MB=2000
MAX_DOC_SIZE_MB=30

# Thanh toán PayOS (my.payos.vn)
PAYMENT_GATEWAY=payos
PAYOS_CLIENT_ID=CHANGE_PAYOS_CLIENT_ID
PAYOS_API_KEY=CHANGE_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=CHANGE_PAYOS_CHECKSUM_KEY

# Email SMTP (quên mật khẩu & nhắc ôn tập)
MAIL_TRANSPORT=smtp
MAIL_FROM=Tiếng Trung 365 <no-reply@tiengtrung365vn.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=CHANGE_SMTP_API_KEY_OR_APP_PASSWORD
MAIL_DEV_OUTBOX=false

# Nhắc ôn tập mỗi ngày (Cloud Scheduler -> POST /api/reminders/run)
REMINDER_CRON_SECRET=CHANGE_TO_RANDOM_HEX_AT_LEAST_32_CHARS
REMINDER_CRON_ENABLED=false

# ===== 3. Frontend (Next.js — Cloud Run: chinese-learner-client) =====
# Truyền vào --build-arg lúc build Docker image Frontend
NEXT_PUBLIC_API_URL=https://api.tiengtrung365vn.com/api
NEXT_PUBLIC_SUPPORT_CONTACT=
NEXT_PUBLIC_REFUND_POLICY=
