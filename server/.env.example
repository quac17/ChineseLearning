# ============================================================================
# Biến môi trường Backend (NestJS — server/)
# Chạy `yarn env` ở thư mục gốc để tự động tạo `server/.env` từ mẫu này
# ============================================================================

# Cổng chạy Backend API
PORT=4000

# Kết nối PostgreSQL (phải khớp với `.env` ở thư mục gốc — mặc định 5433 để tránh trùng cổng 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=vankinh
POSTGRES_PASSWORD=vankinh_secret
POSTGRES_DB=vankinh_db

# Dùng DATABASE_URL khi deploy lên GCP Cloud SQL (nếu bật dòng dưới sẽ ưu tiên dùng chuỗi này)
# DATABASE_URL=postgresql://vankinh:vankinh_secret@localhost:5432/vankinh_db

# Xác thực JWT & HTTP-only Cookie duy trì đăng nhập
# Khi NODE_ENV=production, server KHÔNG khởi động nếu JWT_SECRET là giá trị mẫu này hoặc ngắn hơn
# 32 ký tự, COOKIE_SECURE khác true, CORS_ORIGIN/APP_URL không phải https, hoặc PAYMENT_GATEWAY khác payos
# (xem server/src/config/production-env.ts và tmp/HUONG-DAN-DEPLOY-GCP.md).
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=vankinh_token
# Đặt true khi chạy HTTPS trên GCP Production
COOKIE_SECURE=false
# Dùng 'lax' cho local / cùng tên miền cha, dùng 'none' nếu FE & BE khác tên miền HTTPS
COOKIE_SAME_SITE=lax

# Cấu hình CORS & Kho lưu trữ Video / Tài liệu (.doc, .docx, .ppt, .pptx)
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=500
MAX_DOC_SIZE_MB=50
MAX_SUBTITLE_SIZE_KB=512
# Ảnh bìa khoá học (.jpg, .png, .webp), công khai như ảnh quảng cáo
MAX_COVER_SIZE_MB=2

# Nơi lưu video / tài liệu / phụ đề / ảnh bìa.
# local = thư mục UPLOAD_DIR (mặc định, dùng cho local và e2e).
# gcs   = bucket Google Cloud Storage RIÊNG TƯ (production). Video lớn tải thẳng lên bucket
#         bằng signed URL; bài trả phí chỉ nhận link có thời hạn sau khi kiểm tra quyền xem.
#         Khi đó UPLOAD_DIR chỉ là thư mục tạm (ví dụ /tmp/vankinh-uploads trên Cloud Run).
STORAGE_BACKEND=local
# Tên bucket (bắt buộc khi STORAGE_BACKEND=gcs). Không bật quyền công khai cho bucket.
GCS_BUCKET=your-private-bucket-name
# Tuỳ chọn: project chứa bucket (mặc định lấy từ Application Default Credentials)
# GCS_PROJECT_ID=your-gcp-project-id
# Thời hạn link xem/tải (phút) và link tải lên của giáo viên (phút)
GCS_SIGNED_URL_TTL_MIN=15
GCS_UPLOAD_URL_TTL_MIN=30
# Xác thực: trên Cloud Run dùng service account của dịch vụ (không cần file key).
# Ở máy local, chạy `gcloud auth application-default login`, hoặc trỏ tới file key
# đặt NGOÀI thư mục repo. TUYỆT ĐỐI không commit file key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/service-account.json

# Thanh toán (PayOS). PayOS KHÔNG có môi trường sandbox: mọi giao dịch là tiền thật.
# fake = cổng giả lập cho local/e2e (có nút "Giả lập: đã thanh toán"); bị chặn khi NODE_ENV=production.
# payos = gọi PayOS thật, cần 3 key ở dưới (lấy trong Kênh thanh toán trên my.payos.vn).
PAYMENT_GATEWAY=fake
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# Địa chỉ web học viên: PayOS quay về ${APP_URL}/checkout/<mã đơn> sau khi thanh toán
APP_URL=http://localhost:3000
# Chỉ dùng cho cổng giả lập (ký webhook giả); không phải key thật
FAKE_PAYMENT_CHECKSUM_KEY=vankinh-fake-checksum-key
