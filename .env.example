# ============================================================================
# Biến môi trường gốc — Dùng cho PostgreSQL Docker Compose (docker-compose.yml)
# Chạy `yarn env` ở thư mục gốc để tự động tạo file `.env` từ mẫu này
# ============================================================================

# Địa chỉ & cổng PostgreSQL (dùng mặc định 5433 để tránh trùng PostgreSQL cài sẵn trên máy ở cổng 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Tài khoản & tên database PostgreSQL
POSTGRES_USER=vankinh
POSTGRES_PASSWORD=vankinh_secret
POSTGRES_DB=vankinh_db
