# ============================================================================
# Mẫu biến môi trường tổng hợp cho môi trường DEV (Chinese Learner)
# Chạy `yarn env_dev` ở thư mục gốc để tự động tạo file `.env.dev` từ mẫu này
# ============================================================================

# ===== 1. PostgreSQL (Docker Compose / Local Dev) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=chinese_learner
POSTGRES_PASSWORD=chinese_learner_secret
POSTGRES_DB=chinese_learner_db

# ===== 2. Backend (NestJS — server/) =====
PORT=4000
# Nếu deploy dev lên GCP Cloud SQL, bỏ comment và điền chuỗi kết nối bên dưới:
# DATABASE_URL=postgresql://chinese_learner:chinese_learner_secret@localhost:5433/chinese_learner_db

# Xác thực JWT & HTTP-only Cookie
JWT_SECRET=dev_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=chinese_learner_token
# Local HTTP để false; nếu deploy dev HTTPS (Cloud Run / GitHub Pages / Vercel) đặt true
COOKIE_SECURE=false
# Local / cùng domain cha dùng 'lax'; nếu FE (github.io / vercel.app) khác domain BE (run.app) dùng 'none'
COOKIE_SAME_SITE=lax

# CORS & Lưu trữ tài liệu (.doc, .docx, .ppt, .pptx)
# Nếu chạy dev với GitHub Pages: CORS_ORIGIN=https://quac17.github.io
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=500
MAX_DOC_SIZE_MB=50
MAX_AUDIO_SIZE_MB=10

# ===== 3. Frontend (Next.js — user-client/) =====
# Local dev: http://localhost:4000/api
# Dev trên Cloud Run / GitHub Pages: https://chinese-learner-server-xxxxxx-as.a.run.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
