# ============================================================================
# Biến môi trường Frontend (Next.js — user-client/)
# Chạy `yarn env` ở thư mục gốc để tự động tạo `user-client/.env.local` từ mẫu này
# ============================================================================

# Đường dẫn API của Backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Hiện trên trang thanh toán; để trống thì ẩn dòng tương ứng.
# Ví dụ: "Zalo 09xx xxx xxx" hoặc "hotro@ten-mien.vn"
NEXT_PUBLIC_SUPPORT_CONTACT=
# Một câu chính sách hoàn tiền thật của bạn, hiện dưới nút mua
NEXT_PUBLIC_REFUND_POLICY=
